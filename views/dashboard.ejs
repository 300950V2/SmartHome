<!DOCTYPE html>
<html lang="th">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Smart Home Dashboard</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/usage.css">
</head>

<body>
  <div class="dash-wrap">

    <div class="dash-header">
      <div class="dash-header-left">
        <div class="dash-logo">🏠</div>
        <div>
          <div class="dash-title">Smart Home</div>
          <div class="dash-subtitle">สวัสดี, <%= username %>
          </div>
        </div>
      </div>
      <div class="header-actions">
        <a href="/change-password" class="icon-btn" title="เปลี่ยนรหัสผ่าน">🔒</a>
        <form method="POST" action="/logout">
          <button type="submit" class="icon-btn" title="ออกจากระบบ">⏻</button>
        </form>
      </div>
    </div>

    <!-- ===== Sensor cards ===== -->
    <div class="sensor-grid">
      <div class="sensor-card glass">
        <div class="sensor-label">🌤️ ภายนอก</div>
        <div class="sensor-temp"><span id="outdoor-temp">
            <%= sensor.outdoor.temp !==null ? sensor.outdoor.temp.toFixed(1) : '--' %>
          </span><span>°C</span></div>
        <div class="sensor-humidity">💧 ความชื้น <span id="outdoor-humidity">
            <%= sensor.outdoor.humidity !==null ? Math.round(sensor.outdoor.humidity) : '--' %>
          </span>%</div>
      </div>
      <div class="sensor-card glass">
        <div class="sensor-label">🛏️ ห้องนอน</div>
        <div class="sensor-temp"><span id="bedroom-temp">
            <%= sensor.bedroom.temp !==null ? sensor.bedroom.temp.toFixed(1) : '--' %>
          </span><span>°C</span></div>
        <div class="sensor-humidity">💧 ความชื้น <span id="bedroom-humidity">
            <%= sensor.bedroom.humidity !==null ? Math.round(sensor.bedroom.humidity) : '--' %>
          </span>%</div>
      </div>
      <div class="sensor-updated" id="last-update">
        <%= sensor.lastUpdate ? 'อัปเดตล่าสุด ' + new Date(sensor.lastUpdate).toLocaleString('th-TH')
          : 'ยังไม่มีข้อมูลจากเซ็นเซอร์' %>
      </div>
    </div>

    <!-- ===== PZEM: ค่าไฟฟ้าจากมิเตอร์วัด (การ์ดเดียว เรียงรายการเหมือนใน ESPHome) ===== -->
    <div class="section">
      <div class="section-title">ไฟฟ้า (PZEM)</div>
      <div class="pzem-card glass">
        <div class="pzem-row">
          <span class="pzem-label">⚡ Voltage</span>
          <span class="pzem-value" id="pzem-voltage">
            <%= pzem && pzem.voltage !==null && pzem.voltage !==undefined ? pzem.voltage.toFixed(1) : '--' %> V
          </span>
        </div>
        <div class="pzem-row">
          <span class="pzem-label">〰️ Current</span>
          <span class="pzem-value" id="pzem-current">
            <%= pzem && pzem.current !==null && pzem.current !==undefined ? pzem.current.toFixed(3) : '--' %> A
          </span>
        </div>
        <div class="pzem-row">
          <span class="pzem-label">🔌 Power</span>
          <span class="pzem-value" id="pzem-power">
            <%= pzem && pzem.power !==null && pzem.power !==undefined ? pzem.power.toFixed(2) : '--' %> W
          </span>
        </div>
        <div class="pzem-row">
          <span class="pzem-label">🔋 Energy</span>
          <span class="pzem-value" id="pzem-energy">
            <%= pzem && pzem.energy !==null && pzem.energy !==undefined ? pzem.energy.toFixed(0) : '--' %> Wh
          </span>
        </div>
        <div class="pzem-row">
          <span class="pzem-label">〰️ Frequency</span>
          <span class="pzem-value" id="pzem-frequency">
            <%= pzem && pzem.frequency !==null && pzem.frequency !==undefined ? pzem.frequency.toFixed(1) : '--' %> Hz
          </span>
        </div>
        <div class="pzem-row">
          <span class="pzem-label">📐 Power Factor</span>
          <span class="pzem-value" id="pzem-power-factor">
            <%= pzem && pzem.powerFactor !==null && pzem.powerFactor !==undefined ? pzem.powerFactor.toFixed(2) : '--'
              %>
          </span>
        </div>
      </div>
    </div>

    <!-- ===== เทรนด์การใช้ไฟย้อนหลัง (รายวัน): ตัวเลขสรุป + กราฟ ===== -->
    <!-- ชี้/แตะที่กราฟเพื่อดูวันที่และหน่วยไฟ (kWh) ของวันนั้น | สไตล์อยู่ใน /css/usage.css -->
    <div class="section">
      <div class="section-title">การใช้ไฟย้อนหลัง</div>
      <div class="usage-card glass">

        <div class="usage-stats">
          <div class="usage-stat usage-stat-main">
            <div class="usage-stat-label">วันนี้</div>
            <div class="usage-stat-value"><span id="usage-today">--</span><small>kWh</small></div>
          </div>
          <div class="usage-stat">
            <div class="usage-stat-label">เฉลี่ยต่อวัน</div>
            <div class="usage-stat-value"><span id="usage-avg">--</span><small>kWh</small></div>
          </div>
          <div class="usage-stat">
            <div class="usage-stat-label">รวมทั้งช่วง</div>
            <div class="usage-stat-value"><span id="usage-total">--</span><small>kWh</small></div>
          </div>
          <div class="usage-stat">
            <div class="usage-stat-label">ใช้สูงสุด <span class="usage-stat-sub" id="usage-peak-date"></span></div>
            <div class="usage-stat-value"><span id="usage-peak">--</span><small>kWh</small></div>
          </div>
        </div>

        <div class="usage-range" role="group" aria-label="เลือกช่วงเวลา">
          <button type="button" class="usage-range-btn" data-days="7" aria-pressed="false">7 วัน</button>
          <button type="button" class="usage-range-btn" data-days="30" aria-pressed="false">30 วัน</button>
          <button type="button" class="usage-range-btn is-active" data-days="60" aria-pressed="true">60 วัน</button>
        </div>

        <div class="usage-chart-wrap">
          <canvas id="pzem-history-chart"></canvas>
        </div>
        <div id="pzem-chart-empty" class="usage-empty" style="display:none;">ยังไม่มีข้อมูลย้อนหลัง</div>
      </div>
    </div>

    <!-- ===== Relay control: BCH8-16M ทั้ง 3 ตัว กดปุ๊บเดียวเป็น pulse ไม่ค้างสถานะ ===== -->
    <div class="section">
      <div class="section-title">ควบคุมเบรกเกอร์ (Relay)</div>
      <div class="relay-grid">
        <button type="button" class="pulse-btn relay-btn" data-key="relayFloor1">⚡ First Floor</button>
        <button type="button" class="pulse-btn relay-btn" data-key="relayAircon">⚡ Air Conditioner</button>
        <button type="button" class="pulse-btn relay-btn" data-key="relayFloor2">⚡ Second Floor</button>
      </div>
      <div class="relay-hint" id="relay-status"></div>
    </div>

    <!-- ===== AC control (รีโมท IR แบบกดยิงสัญญาณ ไม่มีสถานะจริงให้อ่าน) ===== -->
    <div class="section">
      <div class="section-title">เครื่องปรับอากาศ</div>
      <div class="ac-card glass">
        <div class="ac-top">
          <div class="ac-info">
            <div class="ac-icon" id="ac-icon">❄️</div>
            <div>
              <div class="ac-name">แอร์ห้องนอน</div>
              <div class="ac-status" id="ac-status">
                <%= devices.ac.lastAction ? 'กดล่าสุด: ' + ( devices.ac.lastAction==='power_on' ? 'เปิด' :
                  devices.ac.lastAction==='power_off' ? 'ปิด' : /^temp_\d+$/.test(devices.ac.lastAction) ? 'อุณหภูมิ ' +
                  devices.ac.lastAction.replace('temp_', '' ) + '°C' : devices.ac.lastAction ) : 'ยังไม่เคยสั่งงาน' %>
              </div>
            </div>
          </div>
          <div class="ac-power-btns">
            <button type="button" class="pulse-btn" id="ac-power-on">กด เปิด</button>
            <button type="button" class="pulse-btn pulse-btn-off" id="ac-power-off">กด ปิด</button>
          </div>
        </div>

        <!-- ===== เลือกอุณหภูมิ: ปุ่ม +/- ปรับเลขที่ "ยังไม่ส่ง" ก่อน แล้วกด "ตั้งอุณหภูมิ" ทีเดียวค่อยยิง pulse ===== -->
        <div class="ac-temp-picker">
          <div class="temp-picker-row">
            <button type="button" class="temp-step-btn" id="temp-dec" aria-label="ลดอุณหภูมิ">−</button>
            <div class="temp-picker-value"><span id="temp-picker-deg">24</span>°C</div>
            <button type="button" class="temp-step-btn" id="temp-inc" aria-label="เพิ่มอุณหภูมิ">+</button>
          </div>
          <button type="button" class="temp-set-btn" id="temp-set-btn">ตั้งอุณหภูมิ <span
              id="temp-set-deg">24</span>°C</button>
        </div>
      </div>
    </div>

    <!-- ===== Front house lights ===== -->
    <div class="section">
      <div class="section-title">ไฟหน้าบ้าน</div>
      <div class="device-grid">
        <div class="device-card glass <%= devices.frontLight1 ? 'on' : '' %>" data-key="frontLight1">
          <div class="device-top">
            <div class="device-icon">💡</div>
          </div>
          <div>
            <div class="device-name">ไฟหน้าบ้าน 1</div>
            <div class="device-status">
              <%= devices.frontLight1 ? 'เปิดอยู่' : 'ปิดอยู่' %>
            </div>
          </div>
        </div>
        <div class="device-card glass <%= devices.frontLight2 ? 'on' : '' %>" data-key="frontLight2">
          <div class="device-top">
            <div class="device-icon">💡</div>
          </div>
          <div>
            <div class="device-name">ไฟหน้าบ้าน 2</div>
            <div class="device-status">
              <%= devices.frontLight2 ? 'เปิดอยู่' : 'ปิดอยู่' %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ===== Living room lights ===== -->
    <div class="section">
      <div class="section-title">ไฟห้องนั่งเล่น</div>
      <div class="device-grid">
        <div class="device-card glass <%= devices.livingLight1 ? 'on' : '' %>" data-key="livingLight1">
          <div class="device-top">
            <div class="device-icon">💡</div>
          </div>
          <div>
            <div class="device-name">ไฟห้องนั่งเล่น 1</div>
            <div class="device-status">
              <%= devices.livingLight1 ? 'เปิดอยู่' : 'ปิดอยู่' %>
            </div>
          </div>
        </div>
        <div class="device-card glass <%= devices.livingLight2 ? 'on' : '' %>" data-key="livingLight2">
          <div class="device-top">
            <div class="device-icon">💡</div>
          </div>
          <div>
            <div class="device-name">ไฟห้องนั่งเล่น 2</div>
            <div class="device-status">
              <%= devices.livingLight2 ? 'เปิดอยู่' : 'ปิดอยู่' %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <footer class="dash-footer">Smart Home Dashboard</footer>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <script src="/js/dashboard.js"></script>
</body>

</html>