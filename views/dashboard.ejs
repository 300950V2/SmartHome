<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Smart Home Dashboard</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="dash-wrap">

    <div class="dash-header">
      <div class="dash-header-left">
        <div class="dash-logo">🏠</div>
        <div>
          <div class="dash-title">Smart Home</div>
          <div class="dash-subtitle">สวัสดี, <%= username %></div>
        </div>
      </div>
      <div class="header-actions">
        <a href="/change-password" class="icon-btn" title="เปลี่ยนรหัสผ่าน">🔒</a>
        <form method="POST" action="/logout">
          <button type="submit" class="icon-btn" title="ออกจากระบบ">⏻</button>
        </form>
      </div>
    </div>

    <!-- ===== Sensor cards ===== -->
    <div class="sensor-grid">
      <div class="sensor-card glass">
        <div class="sensor-label">🌤️ ภายนอก</div>
        <div class="sensor-temp"><span id="outdoor-temp"><%= sensor.outdoor.temp !== null ? sensor.outdoor.temp.toFixed(1) : '--' %></span><span>°C</span></div>
        <div class="sensor-humidity">💧 ความชื้น <span id="outdoor-humidity"><%= sensor.outdoor.humidity !== null ? Math.round(sensor.outdoor.humidity) : '--' %></span>%</div>
      </div>
      <div class="sensor-card glass">
        <div class="sensor-label">🛏️ ห้องนอน</div>
        <div class="sensor-temp"><span id="bedroom-temp"><%= sensor.bedroom.temp !== null ? sensor.bedroom.temp.toFixed(1) : '--' %></span><span>°C</span></div>
        <div class="sensor-humidity">💧 ความชื้น <span id="bedroom-humidity"><%= sensor.bedroom.humidity !== null ? Math.round(sensor.bedroom.humidity) : '--' %></span>%</div>
      </div>
      <div class="sensor-updated" id="last-update">
        <%= sensor.lastUpdate ? 'อัปเดตล่าสุด ' + new Date(sensor.lastUpdate).toLocaleString('th-TH') : 'ยังไม่มีข้อมูลจากเซ็นเซอร์' %>
      </div>
    </div>

    <!-- ===== AC control (รีโมท IR แบบกดยิงสัญญาณ ไม่มีสถานะจริงให้อ่าน) ===== -->
    <div class="section">
      <div class="section-title">เครื่องปรับอากาศ</div>
      <div class="ac-card glass">
        <div class="ac-top">
          <div class="ac-info">
            <div class="ac-icon" id="ac-icon">❄️</div>
            <div>
              <div class="ac-name">แอร์ห้องนอน</div>
              <div class="ac-status" id="ac-status">
                <%= devices.ac.lastAction ? 'กดล่าสุด: ' + (
                  devices.ac.lastAction === 'power_on' ? 'เปิด' :
                  devices.ac.lastAction === 'power_off' ? 'ปิด' :
                  devices.ac.lastAction === 'temp_up' ? 'อุณหภูมิ 30°C' :
                  devices.ac.lastAction === 'temp_down' ? 'อุณหภูมิ 24°C' : devices.ac.lastAction
                ) : 'ยังไม่เคยสั่งงาน' %>
              </div>
            </div>
          </div>
          <div class="ac-power-btns">
            <button type="button" class="pulse-btn" id="ac-power-on">กด เปิด</button>
            <button type="button" class="pulse-btn pulse-btn-off" id="ac-power-off">กด ปิด</button>
          </div>
        </div>

        <div class="ac-temp-select">
          <div class="temp-opt" data-temp="24">
            <div class="deg">24°</div>
            <div class="unit">เย็นสบาย</div>
          </div>
          <div class="temp-opt" data-temp="30">
            <div class="deg">30°</div>
            <div class="unit">ประหยัดไฟ</div>
          </div>
        </div>
      </div>
    </div>

    <!-- ===== Front house lights ===== -->
    <div class="section">
      <div class="section-title">ไฟหน้าบ้าน</div>
      <div class="device-grid">
        <div class="device-card glass <%= devices.frontLight1 ? 'on' : '' %>" data-key="frontLight1">
          <div class="device-top">
            <div class="device-icon">💡</div>
          </div>
          <div>
            <div class="device-name">ไฟหน้าบ้าน 1</div>
            <div class="device-status"><%= devices.frontLight1 ? 'เปิดอยู่' : 'ปิดอยู่' %></div>
          </div>
        </div>
        <div class="device-card glass <%= devices.frontLight2 ? 'on' : '' %>" data-key="frontLight2">
          <div class="device-top">
            <div class="device-icon">💡</div>
          </div>
          <div>
            <div class="device-name">ไฟหน้าบ้าน 2</div>
            <div class="device-status"><%= devices.frontLight2 ? 'เปิดอยู่' : 'ปิดอยู่' %></div>
          </div>
        </div>
      </div>
    </div>

    <!-- ===== Living room lights ===== -->
    <div class="section">
      <div class="section-title">ไฟห้องนั่งเล่น</div>
      <div class="device-grid">
        <div class="device-card glass <%= devices.livingLight1 ? 'on' : '' %>" data-key="livingLight1">
          <div class="device-top">
            <div class="device-icon">💡</div>
          </div>
          <div>
            <div class="device-name">ไฟห้องนั่งเล่น 1</div>
            <div class="device-status"><%= devices.livingLight1 ? 'เปิดอยู่' : 'ปิดอยู่' %></div>
          </div>
        </div>
        <div class="device-card glass <%= devices.livingLight2 ? 'on' : '' %>" data-key="livingLight2">
          <div class="device-top">
            <div class="device-icon">💡</div>
          </div>
          <div>
            <div class="device-name">ไฟห้องนั่งเล่น 2</div>
            <div class="device-status"><%= devices.livingLight2 ? 'เปิดอยู่' : 'ปิดอยู่' %></div>
          </div>
        </div>
      </div>
    </div>

    <footer class="dash-footer">Smart Home Dashboard</footer>
  </div>

  <script src="/js/dashboard.js"></script>
</body>
</html>
